{
  "name": "ts-icon",
  "version": "0.10.0",
  "description": "NestJS backend for managing and serving TeamSpeak channel banner images, paired with a React admin frontend for uploading and cropping banners.",
  "author": "",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "check": "npm run check:format && npm run lint && npm run typecheck && npm run lint --prefix webapp-banner-tool && npm run typecheck --prefix webapp-banner-tool",
    "format": "npm run format:web && npm run format:docs",
    "build": "tsc -p tsconfig.build.json",
    "start:public": "node dist/src/main.public.js",
    "start:local": "node dist/src/main.local.js",
    "start:dev": "npm run dev",
    "start:debug": "npm run debug:local",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,cjs,mjs}\" config.ts prisma.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "backfill:channel-ids": "ts-node scripts/backfill-channel-ids.ts",
    "setup": "node scripts/bootstrap.cjs",
    "dev": "node scripts/dev.cjs",
    "dev:local": "nest start --watch --path tsconfig.dev.local.json --entryFile main.local",
    "dev:public": "nest start --watch --path tsconfig.dev.public.json --entryFile main.public",
    "debug:local": "nest start --debug 127.0.0.1:9229 --watch --path tsconfig.dev.local.json --entryFile main.local",
    "debug:public": "nest start --debug 127.0.0.1:9230 --watch --path tsconfig.dev.public.json --entryFile main.public",
    "db:generate": "prisma generate",
    "db:migrate": "ts-node scripts/db.ts migrate",
    "db:check": "ts-node scripts/db.ts check",
    "db:backup": "ts-node scripts/db.ts backup",
    "db:restore": "ts-node scripts/db.ts restore",
    "db:dry-run": "ts-node scripts/db.ts dry-run",
    "test:ops": "node --require ts-node/register --test scripts/ops.test.cjs",
    "format:web": "biome format --write .",
    "format:docs": "prettier --write \"**/*.{md,yml,yaml,html}\"",
    "check:format": "npm run check:format:web && npm run check:format:docs",
    "check:format:web": "biome format .",
    "check:format:docs": "prettier --check \"**/*.{md,yml,yaml,html}\"",
    "audit:production": "npm audit --omit=dev --omit=peer --audit-level=high",
    "test:containers": "node scripts/container-smoke.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.4",
    "ipaddr.js": "^2.4.0",
    "jose": "^5.10.0",
    "multer": "^2.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "ts3-nodejs-library": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "jest": "^30.5.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0",
    "@biomejs/biome": "2.5.7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10.9.0 <12"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
